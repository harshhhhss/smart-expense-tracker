# ---------------------------------------------------------------------------
# Root ignore rules. Patterns here are relative to the repo root, so they
# apply to every workspace (backend/, frontend/, and anything added later).
# Keep workspace-specific rules in that workspace's own .gitignore.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/

# Environment / secrets -- never commit real values, only .env.example
.env
.env.*
!.env.example

# Build output
dist/
dist-ssr/
build/

# Logs and captured process output
logs/
*.log
*.err
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Caches and coverage
.cache/
.parcel-cache/
coverage/

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS junk
.DS_Store
Thumbs.db

# Misc
*.local
